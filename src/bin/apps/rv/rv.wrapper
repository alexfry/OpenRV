#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Bash port of the original tcsh OpenRV launcher wrapper.
unset LANG
if [ -z "${RV_HOME:-}" ]; then
  canonicalName="$(readlink -f "$0")"
  binName="$(dirname "$canonicalName")"
  export RV_HOME="$(dirname "$binName")"
fi
platform=i386
bin="$RV_HOME/bin/rv.bin.$platform"
if [ ! -e "$bin" ]; then
  bin="$RV_HOME/bin/rv.bin"
fi
unset BUILD_ROOT
export PATH="$RV_HOME/bin:${PATH}"
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
  export LD_LIBRARY_PATH="$RV_HOME/lib:$LD_LIBRARY_PATH"
else
  export LD_LIBRARY_PATH="$RV_HOME/lib"
fi
if [ -z "${RV_USE_SYSTEM_OPENSSL:-}" ] && [ -d "$RV_HOME/lib/OpenSSL" ]; then
  export LD_LIBRARY_PATH="$RV_HOME/lib/OpenSSL:$LD_LIBRARY_PATH"
fi
# OpenRV's main viewer is still X11/GLX-oriented (QOpenGLWidget + GLX).
# Many desktops export QT_QPA_PLATFORM=wayland;xcb which makes Qt prefer
# Wayland: UI/thumbnails work but the GL image plane can stay black.
# Force XWayland (xcb) unless the user opts into native Wayland (goal 2 / HDR).
#   RV_ALLOW_WAYLAND=1   → leave QT_QPA_PLATFORM alone
#   RV_QT_PLATFORM=...   → explicit override (e.g. xcb, wayland)
if [ -n "${RV_QT_PLATFORM:-}" ]; then
  export QT_QPA_PLATFORM="$RV_QT_PLATFORM"
elif [ -z "${RV_ALLOW_WAYLAND:-}" ] && [ -n "${DISPLAY:-}" ]; then
  export QT_QPA_PLATFORM=xcb
fi
# kvantum is not shipped with the aqt Qt build; silence the QApplication warning
if [ "${QT_STYLE_OVERRIDE:-}" = "kvantum" ]; then
  unset QT_STYLE_OVERRIDE
fi
# Prefer the NVIDIA GLX vendor under X11 when available (Titan RTX etc.)
if [ "${QT_QPA_PLATFORM:-}" = "xcb" ] && [ -z "${__GLX_VENDOR_LIBRARY_NAME:-}" ]; then
  if [ -e /usr/lib/libGLX_nvidia.so.0 ] || [ -e /usr/lib64/libGLX_nvidia.so.0 ]; then
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
  fi
fi
# Qt WebEngine (Chromium) can spam "GPUInfo not initialized on GpuInfoUpdate"
# during early init; raise its log threshold unless the user set flags already.
if [ -z "${QTWEBENGINE_CHROMIUM_FLAGS:-}" ]; then
  export QTWEBENGINE_CHROMIUM_FLAGS="--log-level=3"
fi
exec "$bin" "$@"
