#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Bash port of the original tcsh OpenRV launcher wrapper.
unset LANG
if [ -z "${RV_HOME:-}" ]; then
  canonicalName="$(readlink -f "$0")"
  binName="$(dirname "$canonicalName")"
  export RV_HOME="$(dirname "$binName")"
fi
platform=i386
bin="$RV_HOME/bin/rvls.bin.$platform"
if [ ! -e "$bin" ]; then
  bin="$RV_HOME/bin/rvls.bin"
fi
unset BUILD_ROOT
export PATH="$RV_HOME/bin:${PATH}"
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
  export LD_LIBRARY_PATH="$RV_HOME/lib:$LD_LIBRARY_PATH"
else
  export LD_LIBRARY_PATH="$RV_HOME/lib"
fi
if [ -z "${RV_USE_SYSTEM_OPENSSL:-}" ] && [ -d "$RV_HOME/lib/OpenSSL" ]; then
  export LD_LIBRARY_PATH="$RV_HOME/lib/OpenSSL:$LD_LIBRARY_PATH"
fi
exec "$bin" "$@"
